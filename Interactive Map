<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Schenectady Land Map</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,500&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #f5f2ea;
    --panel: #ffffff;
    --ink: #1c2a24;
    --ink-soft: #5a665f;
    --line: #dcd5c4;
    --moss: #2f4a3c;
    --moss-light: #e8efe8;
    --clay: #b2552f;
    --clay-light: #f3e2d7;
    --gold: #c89a3c;
    --gold-light: #f6edda;
    --slate: #3c5a73;
    --slate-light: #e4edf3;
    --danger: #a33;
    --radius: 10px;
    --font-display: 'Fraunces', serif;
    --font-body: 'Inter', sans-serif;
    font-family: var(--font-body);
  }
  [data-mode="dark"] {
    --bg: #14181a;
    --panel: #1c2225;
    --ink: #eef0e9;
    --ink-soft: #9aa49c;
    --line: #2d3436;
    --moss: #6fae8c;
    --moss-light: #1e2b23;
    --clay: #e08b63;
    --clay-light: #2d2019;
    --gold: #e0b955;
    --gold-light: #2b2415;
    --slate: #7fa9c9;
    --slate-light: #1b2730;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; height: 100%; background: var(--bg); color: var(--ink); font-family: var(--font-body); }
  #app { display: flex; flex-direction: column; height: 100vh; }

  header {
    background: var(--moss);
    color: #f5f2ea;
    padding: 14px 20px;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    border-bottom: 3px solid var(--clay);
  }
  header h1 {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 21px;
    margin: 0;
    letter-spacing: 0.2px;
  }
  header .sub {
    font-size: 12.5px;
    opacity: 0.8;
    font-weight: 400;
  }

  #layout {
    display: flex;
    flex: 1;
    min-height: 0;
  }

  #sidebar {
    width: 290px;
    min-width: 290px;
    background: var(--panel);
    border-right: 1px solid var(--line);
    overflow-y: auto;
    padding: 16px;
  }
  #sidebar h2 {
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 500;
    margin: 18px 0 8px;
    color: var(--ink);
  }
  #sidebar h2:first-child { margin-top: 0; }

  .filter-row {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 0;
    font-size: 13.5px;
    cursor: pointer;
  }
  .filter-row input[type="checkbox"] {
    width: 16px; height: 16px; accent-color: var(--moss); cursor: pointer; flex-shrink: 0;
  }
  .swatch { width: 11px; height: 11px; border-radius: 3px; flex-shrink: 0; border: 1px solid rgba(0,0,0,0.15); }

  .stat-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-bottom: 4px;
  }
  .stat-card {
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 10px 12px;
  }
  .stat-card .num {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 500;
    line-height: 1.1;
  }
  .stat-card .lbl {
    font-size: 11px;
    color: var(--ink-soft);
    margin-top: 2px;
  }

  select, button {
    font-family: var(--font-body);
    font-size: 13px;
  }
  select {
    width: 100%;
    padding: 7px 8px;
    border-radius: 7px;
    border: 1px solid var(--line);
    background: var(--panel);
    color: var(--ink);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 12px;
    border-radius: 7px;
    border: 1px solid var(--line);
    background: var(--panel);
    color: var(--ink);
    cursor: pointer;
    font-weight: 500;
  }
  .btn:hover { background: var(--bg); }
  .btn-primary { background: var(--moss); color: #fff; border-color: var(--moss); }
  .btn-primary:hover { background: #26392f; }
  .btn-block { width: 100%; justify-content: center; margin-top: 6px; }
  .btn-sm { padding: 4px 9px; font-size: 12px; }

  #map-wrap { flex: 1; position: relative; min-width: 0; }
  #map { width: 100%; height: 100%; background: #e9e4d6; }

  .leaflet-popup-content-wrapper {
    border-radius: 10px;
    font-family: var(--font-body);
  }
  .leaflet-popup-content { margin: 12px 14px; min-width: 220px; }
  .pop-title { font-family: var(--font-display); font-size: 16px; font-weight: 500; margin: 0 0 6px; }
  .pop-row { display: flex; justify-content: space-between; gap: 10px; font-size: 12.5px; padding: 3px 0; border-bottom: 1px solid #eee; }
  .pop-row:last-of-type { border-bottom: none; }
  .pop-row .k { color: var(--ink-soft); }
  .pop-row .v { text-align: right; font-weight: 500; }
  .pop-badge {
    display: inline-block;
    font-size: 11px;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 20px;
    margin-bottom: 8px;
  }
  .pop-actions { margin-top: 10px; display: flex; gap: 6px; }
  .pop-photo { width: 100%; border-radius: 7px; margin-top: 8px; display: block; }

  .nbhd-label {
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 500;
    color: var(--ink);
    text-shadow: 0 0 4px var(--bg), 0 0 4px var(--bg), 0 0 8px var(--bg);
    white-space: nowrap;
    pointer-events: none;
  }

  /* Modal */
  #modal-overlay {
    position: absolute; inset: 0; background: rgba(20, 24, 26, 0.45);
    display: none; align-items: center; justify-content: center; z-index: 1000; padding: 20px;
  }
  #modal-overlay.open { display: flex; }
  #modal {
    background: var(--panel);
    border-radius: 14px;
    width: 100%;
    max-width: 440px;
    max-height: 86vh;
    overflow-y: auto;
    padding: 22px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.25);
  }
  #modal h3 {
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 500;
    margin: 0 0 14px;
  }
  .field { margin-bottom: 12px; }
  .field label {
    display: block;
    font-size: 12px;
    font-weight: 600;
    color: var(--ink-soft);
    margin-bottom: 4px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  .field input[type="text"], .field input[type="number"], .field textarea, .field select {
    width: 100%;
    padding: 8px 10px;
    border-radius: 7px;
    border: 1px solid var(--line);
    background: var(--bg);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 13.5px;
  }
  .field textarea { resize: vertical; min-height: 56px; }
  .field-row { display: flex; gap: 10px; }
  .field-row .field { flex: 1; }
  .err { color: var(--danger); font-size: 12px; margin-top: 4px; display: none; }
  .err.show { display: block; }
  .modal-actions { display: flex; gap: 8px; margin-top: 18px; }
  .modal-actions .btn { flex: 1; }

  #close-modal {
    position: absolute; top: 14px; right: 14px; cursor: pointer; background: none; border: none; font-size: 20px; color: var(--ink-soft); padding: 4px;
  }
  #modal { position: relative; }

  .empty-note {
    font-size: 12.5px;
    color: var(--ink-soft);
    line-height: 1.5;
    padding: 10px 0;
  }

  #photo-current { max-width: 100%; border-radius: 7px; margin-top: 6px; display: none; }

  @media (max-width: 760px) {
    #layout { flex-direction: column; }
    #sidebar { width: 100%; min-width: 0; max-height: 40vh; border-right: none; border-bottom: 1px solid var(--line); }
  }
</style>
</head>
<body>

<div id="app">
  <header>
    <div>
      <h1>Schenectady land map</h1>
      <div class="sub">Vacant lots, ownership, and what's in motion — Ancient Roots Cooperative</div>
    </div>
    <button class="btn btn-sm" id="add-btn" style="color:#fff;border-color:rgba(255,255,255,0.4);">+ Add a location</button>
  </header>

  <div id="layout">
    <aside id="sidebar">
      <h2>Overview</h2>
      <div class="stat-grid" id="stat-grid"></div>

      <h2>Category</h2>
      <div id="category-filters"></div>

      <h2>Owner type</h2>
      <div id="owner-filters"></div>

      <h2>Neighborhood</h2>
      <select id="nbhd-select">
        <option value="all">All neighborhoods</option>
      </select>

      <h2>Layers</h2>
      <div class="filter-row"><input type="checkbox" id="toggle-city" checked><label for="toggle-city">City outline</label></div>
      <div class="filter-row"><input type="checkbox" id="toggle-nbhd" checked><label for="toggle-nbhd">Neighborhood outlines</label></div>
      <div class="filter-row"><input type="checkbox" id="toggle-pins" checked><label for="toggle-pins">Property pins</label></div>
      <div class="filter-row"><input type="checkbox" id="toggle-motion"><label for="toggle-motion">Only show active projects</label></div>
      <div class="filter-row"><input type="checkbox" id="toggle-transit" checked><label for="toggle-transit">Bus routes</label></div>
      <div class="filter-row"><input type="checkbox" id="toggle-stops" checked><label for="toggle-stops">Bus stops</label></div>
      <div class="filter-row"><input type="checkbox" id="toggle-walkshed"><label for="toggle-walkshed">1/4 mile walk to stop</label></div>

      <button class="btn btn-block" id="reset-btn">Reset filters</button>

      <h2>Transit legend</h2>
      <div id="route-legend"></div>

      <p class="empty-note">This map is a working document. Click any pin to see details, or add a new location as you learn about it. Neighborhood boundaries and bus routes here are approximate — refine them with real CDTA route data as it becomes available.</p>
    </aside>

    <div id="map-wrap">
      <div id="map"></div>

      <div id="modal-overlay">
        <div id="modal">
          <button id="close-modal" aria-label="Close">&times;</button>
          <h3 id="modal-title">Add a location</h3>
          <form id="location-form">
            <div class="field">
              <label for="f-address">Address</label>
              <input type="text" id="f-address" placeholder="1052 Parkwood Blvd">
              <div class="err" id="err-address">Enter an address.</div>
            </div>
            <div class="field-row">
              <div class="field">
                <label for="f-lat">Latitude</label>
                <input type="number" step="any" id="f-lat" placeholder="42.8114">
              </div>
              <div class="field">
                <label for="f-lng">Longitude</label>
                <input type="number" step="any" id="f-lng" placeholder="-73.9183">
              </div>
            </div>
            <div class="err" id="err-coords">Enter a valid latitude and longitude for Schenectady.</div>

            <div class="field">
              <label for="f-category">Category</label>
              <select id="f-category">
                <option value="buildable">Buildable</option>
                <option value="verify">Needs verification</option>
                <option value="garden">Not buildable — garden or shed</option>
                <option value="metroplex">Metroplex owned</option>
                <option value="bcni">BCNI owned</option>
                <option value="community">Community space</option>
              </select>
            </div>

            <div class="field-row">
              <div class="field">
                <label for="f-owner-type">Owner type</label>
                <select id="f-owner-type">
                  <option value="city">City of Schenectady</option>
                  <option value="metroplex">Metroplex</option>
                  <option value="individual">Individual</option>
                  <option value="llc">LLC / developer</option>
                  <option value="bcni">BCNI</option>
                  <option value="other">Other</option>
                </select>
              </div>
              <div class="field">
                <label for="f-lot-size">Lot size (sq ft)</label>
                <input type="number" id="f-lot-size" placeholder="4500">
              </div>
            </div>

            <div class="field">
              <label for="f-owner">Owner name</label>
              <input type="text" id="f-owner" placeholder="Owner or company name">
            </div>

            <div class="field">
              <label for="f-status">Status / movement</label>
              <select id="f-status">
                <option value="none">No activity yet</option>
                <option value="review">Under review</option>
                <option value="contacted">City contacted</option>
                <option value="visit">Site visit scheduled</option>
                <option value="acquisition">Acquisition in progress</option>
                <option value="tinyhome">Tiny home development underway</option>
                <option value="garden-dev">Community garden underway</option>
                <option value="complete">Complete</option>
              </select>
            </div>

            <div class="field">
              <label for="f-notes">Notes</label>
              <textarea id="f-notes" placeholder="Any context worth remembering about this property"></textarea>
            </div>

            <div class="field">
              <label for="f-photo">Photo URL</label>
              <input type="text" id="f-photo" placeholder="Paste an image link, or a Google Maps street view URL">
              <img id="photo-current" alt="Preview">
            </div>

            <div class="modal-actions">
              <button type="button" class="btn" id="cancel-btn">Cancel</button>
              <button type="button" class="btn btn-primary" id="save-btn">Save location</button>
            </div>
            <div class="modal-actions" id="delete-row" style="display:none;">
              <button type="button" class="btn" id="delete-btn" style="color:var(--danger); border-color:var(--danger);">Delete this location</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
<script>

